{
  "//": "ŞABLON — bu dosyayı appsettings.Local.json'a KOPYALAMAYIN. Gerçek değerler için 'dotnet user-secrets' kullanın:",
  "//1": "dotnet user-secrets init --project src/PsikoAl.Api",
  "//2": "dotnet user-secrets set \"Supabase:Url\" \"https://<proje-ref>.supabase.co\" --project src/PsikoAl.Api",
  "//3": "dotnet user-secrets set \"Supabase:AnonKey\" \"<anon-key>\" --project src/PsikoAl.Api",
  "//4": "dotnet user-secrets set \"Supabase:ServiceRoleKey\" \"<service-role-key>\" --project src/PsikoAl.Api",
  "//5": "dotnet user-secrets set \"ConnectionStrings:Postgres\" \"<postgres-connection-string>\" --project src/PsikoAl.Api",
  "Supabase": {
    "Url": "https://<proje-ref>.supabase.co",
    "AnonKey": "<anon-key>",
    "ServiceRoleKey": "<service-role-key — ASLA repoya girmez, ASLA istemciye gitmez>"
  },
  "ConnectionStrings": {
    "Postgres": "Host=<host>;Port=5432;Database=postgres;Username=<user>;Password=<parola>;SSL Mode=Require;Trust Server Certificate=true"
  }
}
