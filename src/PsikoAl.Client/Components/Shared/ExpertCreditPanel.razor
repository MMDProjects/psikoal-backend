@* Uzmanın kredi bakiyesi, defteri ve elle düzeltme. Finans uçlarını çağırır; yalnız
   AdminRoleGroups.Finance'teki rollere gösterilir (çağıran sayfa kontrol eder). *@
@inject IAdminClientService AdminClient

<div class="stack-3" data-testid="expert-credit-panel">
    @if (_errorMessage is not null)
    {
        <Alert Variant="AlertVariant.Destructive">
            <AlertDescription>@_errorMessage</AlertDescription>
        </Alert>
    }

    @if (_isLoading && _credits is null)
    {
        <LoadingSkeleton />
    }
    else if (_credits is not null)
    {
        <div class="credit-summary">
            <div>
                <span class="muted">Güncel bakiye</span>
                <div class="text-2xl font-semibold" data-testid="expert-credit-balance">@_credits.Balance kredi</div>
            </div>
            <Button Size="ButtonSize.Sm" data-testid="expert-credit-adjust" OnClick="OpenAdjust">Kredi Düzelt</Button>
        </div>

        @if (_credits.Transactions.Data.Count == 0)
        {
            <EmptyState Title="Kredi hareketi yok" Description="Bu uzman henüz kredi yüklemedi ya da harcamadı." />
        }
        else
        {
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>Zaman</TableHead>
                        <TableHead>Tür</TableHead>
                        <TableHead Class="text-right">Miktar</TableHead>
                        <TableHead Class="text-right">Sonraki bakiye</TableHead>
                        <TableHead>Gerekçe / Admin</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var row in _credits.Transactions.Data)
                    {
                        <TableRow>
                            <TableCell Class="text-muted-foreground">@row.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</TableCell>
                            <TableCell>@row.TypeLabel</TableCell>
                            <TableCell Class="text-right font-medium">@(row.Amount > 0 ? "+" : string.Empty)@row.Amount</TableCell>
                            <TableCell Class="text-right">@row.BalanceAfter</TableCell>
                            <TableCell>
                                @(row.Reason ?? "—")
                                @if (row.AdminName is not null)
                                {
                                    <div class="muted">@row.AdminName</div>
                                }
                            </TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
            <Pager Meta="_credits.Transactions.Meta" Disabled="_isLoading" OnPageChanged="GoToPageAsync" />
        }
    }
</div>

<Dialog Open="_isAdjustOpen" OpenChanged="value => _isAdjustOpen = value">
    <DialogContent Size="DialogSize.Md">
        <DialogHeader>
            <DialogTitle>Kredi düzeltmesi</DialogTitle>
            <DialogDescription>
                Pozitif değer kredi ekler, negatif değer düşer. Bakiye eksiye düşemez.
                Gerekçe uzmanın kredi geçmişinde görünür ve denetim kaydına yazılır.
            </DialogDescription>
        </DialogHeader>

        <div class="field">
            <Label>Miktar (kredi)</Label>
            <Input Type="number" data-testid="expert-credit-amount" Placeholder="ör. 20 ya da -3" @bind-Value="_amount" />
        </div>
        <div class="field">
            <Label>Gerekçe</Label>
            <Textarea Rows="3" data-testid="expert-credit-reason" Placeholder="Hatalı düşüm iadesi, kampanya..." @bind-Value="_reason" />
        </div>

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="() => _isAdjustOpen = false">Vazgeç</Button>
            <Button Disabled="@(ParsedAmount is null || string.IsNullOrWhiteSpace(_reason))" OnClick="AskConfirm">Devam</Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

<ConfirmDialog Open="_isConfirmOpen"
               OpenChanged="value => _isConfirmOpen = value"
               Title="Kredi düzeltmesini onaylayın"
               Description="@ConfirmText"
               ConfirmLabel="Uygula"
               OnConfirm="AdjustConfirmedAsync" />

@code {
    private const int PerPage = 20;

    [Parameter, EditorRequired]
    public Guid ExpertId { get; set; }

    private AdminExpertCreditsDto? _credits;
    private int _page = 1;
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _isAdjustOpen;
    private bool _isConfirmOpen;
    private string _amount = string.Empty;
    private string _reason = string.Empty;
    private Guid? _loadedExpertId;

    private int? ParsedAmount
        => int.TryParse(_amount, System.Globalization.NumberStyles.AllowLeadingSign, System.Globalization.CultureInfo.InvariantCulture, out var value)
            && value != 0
            ? value
            : null;

    private string ConfirmText
        => ParsedAmount is { } amount
            ? $"{Math.Abs(amount)} kredi {(amount > 0 ? "eklenecek" : "düşülecek")}. Gerekçe: {_reason.Trim()}"
            : string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedExpertId != ExpertId)
        {
            _loadedExpertId = ExpertId;
            _page = 1;
            _credits = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var result = await AdminClient.GetExpertCreditsAsync(ExpertId, _page, PerPage, CancellationToken.None);
            _credits = result.Value ?? _credits;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private void OpenAdjust()
    {
        _amount = string.Empty;
        _reason = string.Empty;
        _isAdjustOpen = true;
    }

    private void AskConfirm()
    {
        if (ParsedAmount is null || string.IsNullOrWhiteSpace(_reason))
        {
            return;
        }

        _isAdjustOpen = false;
        _isConfirmOpen = true;
    }

    private async Task AdjustConfirmedAsync()
    {
        _isConfirmOpen = false;
        if (ParsedAmount is not { } amount || string.IsNullOrWhiteSpace(_reason))
        {
            return;
        }

        var result = await AdminClient.AdjustExpertCreditsAsync(ExpertId, amount, _reason.Trim(), CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Value is { } updated)
        {
            _credits = updated;
            _page = 1;
        }
    }
}
