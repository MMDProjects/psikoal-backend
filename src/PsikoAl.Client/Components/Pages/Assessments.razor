@page "/assessments"
@rendermode InteractiveServer
@inject IAdminClientService AdminClient
@inject AdminSessionState Session
@inject NavigationManager Navigation

<PageTitle>Testler — PsikoAl Admin</PageTitle>

<div class="page-shell">
    <header class="page-header">
        <div>
            <span class="page-eyebrow">PsikoAl Admin</span>
            <h1 class="page-title">Psikolojik Testler</h1>
        </div>
        <div class="page-header-actions">
            <a class="btn-ghost" href="/users">Kullanıcılar</a>
            <a class="btn-ghost" href="/experts">Uzmanlar</a>
            <a class="btn-ghost" href="/categories">Kategoriler</a>
            <a class="btn-ghost" href="/reviews">Yorumlar</a>
            <a class="btn-ghost" href="/listings">İlanlar</a>
            <a class="btn-ghost" href="/matches">Eşleşmeler</a>
            <a class="btn-ghost" href="/settings">Sistem Ayarları</a>
            <a class="btn-ghost" href="/notifications">Bildirimler</a>
            <span class="muted">@Session.Email</span>
        </div>
    </header>

    <p class="muted">
        Sorular sadece görüntülenir (düzenleme için migration gerekir). Başlık/açıklama/aktiflik ve puan
        bantlarının özet/öneri metinleri buradan düzenlenebilir.
    </p>

    @if (_errorMessage is not null)
    {
        <p class="form-error">@_errorMessage</p>
    }

    @if (_isLoading)
    {
        <p class="muted">Yükleniyor...</p>
    }
    else if (_assessments is not null)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Sıra</th>
                    <th>Başlık</th>
                    <th>Kategori</th>
                    <th>Soru</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var assessment in _assessments)
                {
                    <tr>
                        <td>@assessment.SortOrder</td>
                        <td>@assessment.Title</td>
                        <td class="muted">@assessment.Category</td>
                        <td class="muted">@assessment.QuestionCount</td>
                        <td>
                            <span class="chip @(assessment.IsActive ? "chip-active" : "chip-frozen")">
                                @(assessment.IsActive ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td class="cell-actions">
                            <button class="btn-ghost" @onclick="() => ToggleDetailAsync(assessment.Id)">
                                @(_openId == assessment.Id ? "Kapat" : "Düzenle")
                            </button>
                        </td>
                    </tr>
                    @if (_openId == assessment.Id && _detail is not null)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="detail-panel">
                                    <h3 class="detail-heading">Test Bilgisi</h3>
                                    <label>Başlık</label>
                                    <input class="field-input" style="width:100%" @bind="_editTitle" />
                                    <label>Açıklama</label>
                                    <input class="field-input" style="width:100%" @bind="_editDescription" />
                                    <div class="toolbar">
                                        <input class="field-input" style="width:140px" placeholder="Kategori" @bind="_editCategory" />
                                        <input class="field-input" style="width:100px" type="number" placeholder="Dakika" @bind="_editMinutes" />
                                        <input class="field-input" style="width:100px" type="number" placeholder="Sıra" @bind="_editSortOrder" />
                                        <label><input type="checkbox" @bind="_editActive" /> Aktif</label>
                                        <button class="btn-primary" @onclick="() => SaveAssessmentAsync(assessment.Id)">Kaydet</button>
                                    </div>

                                    <h3 class="detail-heading">Puan Bantları</h3>
                                    @foreach (var rule in _detail.ScoreRules)
                                    {
                                        <div class="detail-panel">
                                            <p class="muted">@rule.MinScore–@rule.MaxScore puan → @rule.Level</p>
                                            <input class="field-input" style="width:100%" value="@rule.Summary"
                                                   @onchange="@(e => _ruleSummaryEdits[rule.Id] = e.Value?.ToString() ?? string.Empty)" />
                                            <input class="field-input" style="width:100%" value="@string.Join(" | ", rule.Suggestions)"
                                                   placeholder="Öneriler ( | ile ayırın)"
                                                   @onchange="@(e => _ruleSuggestionsEdits[rule.Id] = e.Value?.ToString() ?? string.Empty)" />
                                            <button class="btn-ghost" @onclick="() => SaveScoreRuleAsync(rule.Id)">Bandı Kaydet</button>
                                        </div>
                                    }

                                    <h3 class="detail-heading">Sorular (@_detail.Questions.Count)</h3>
                                    @foreach (var question in _detail.Questions)
                                    {
                                        <p class="muted">@question.Text</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<AdminAssessmentListItemDto>? _assessments;
    private AdminAssessmentDetailDto? _detail;
    private Guid? _openId;
    private readonly Dictionary<Guid, string> _ruleSummaryEdits = [];
    private readonly Dictionary<Guid, string> _ruleSuggestionsEdits = [];

    private string _editTitle = string.Empty;
    private string _editDescription = string.Empty;
    private string _editCategory = string.Empty;
    private int _editMinutes = 3;
    private int _editSortOrder;
    private bool _editActive;

    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _assessments = await AdminClient.ListAssessmentsAsync(CancellationToken.None);
            if (_assessments is null)
            {
                _errorMessage = "Liste alınamadı. Admin yetkiniz olmayabilir.";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleDetailAsync(Guid assessmentId)
    {
        if (_openId == assessmentId)
        {
            _openId = null;
            _detail = null;
            return;
        }

        _openId = assessmentId;
        _detail = await AdminClient.GetAssessmentDetailAsync(assessmentId, CancellationToken.None);
        if (_detail is not null)
        {
            _editTitle = _detail.Title;
            _editDescription = _detail.Description;
            _editCategory = _detail.Category;
            _editMinutes = _detail.EstimatedMinutes;
            _editSortOrder = _detail.SortOrder;
            _editActive = _detail.IsActive;
            _ruleSummaryEdits.Clear();
            _ruleSuggestionsEdits.Clear();
        }
    }

    private async Task SaveAssessmentAsync(Guid assessmentId)
    {
        var success = await AdminClient.UpdateAssessmentAsync(
            assessmentId,
            new UpdateAdminAssessmentDto(_editTitle, _editDescription, _editCategory, _editMinutes, _editActive, _editSortOrder),
            CancellationToken.None);

        if (success)
        {
            _openId = null;
            await LoadAsync();
        }
        else
        {
            _errorMessage = "Test güncellenemedi.";
        }
    }

    private async Task SaveScoreRuleAsync(Guid ruleId)
    {
        if (_detail is null)
        {
            return;
        }

        var rule = _detail.ScoreRules.First(r => r.Id == ruleId);
        var summary = _ruleSummaryEdits.GetValueOrDefault(ruleId, rule.Summary);
        var suggestionsRaw = _ruleSuggestionsEdits.GetValueOrDefault(ruleId, string.Join(" | ", rule.Suggestions));
        var suggestions = suggestionsRaw.Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

        var success = await AdminClient.UpdateScoreRuleAsync(
            ruleId,
            new UpdateAdminScoreRuleDto(summary, suggestions),
            CancellationToken.None);

        if (success && _openId.HasValue)
        {
            _detail = await AdminClient.GetAssessmentDetailAsync(_openId.Value, CancellationToken.None);
        }
        else if (!success)
        {
            _errorMessage = "Puan bandı güncellenemedi.";
        }
    }
}
