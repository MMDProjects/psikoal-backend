@page "/credit-payments"
@inject IAdminClientService AdminClient

<PageTitle>Satın Almalar — PsikoAl Admin</PageTitle>

<PageHeader Title="Satın Almalar"
            Description="Web sitesinden PayTR ile yapılan kredi satın almaları. Krediyi yalnız PayTR'nin doğrulanmış bildirimi yükler; bekleyen kayıt ödeme sayfasının kapatıldığı anlamına da gelebilir." />

<div class="toolbar">
    <Select Class="toolbar-select" @bind-Value="_status">
        <option value="">Tümü</option>
        <option value="PAID">Ödendi</option>
        <option value="PENDING">Beklemede</option>
        <option value="FAILED">Başarısız</option>
    </Select>
    <Button Disabled="_isLoading" data-testid="credit-payments-filter" OnClick="FilterAsync">Filtrele</Button>
</div>

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="table-card" data-testid="credit-payments-table">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_payments is { Count: 0 })
    {
        <EmptyState Title="Satın alma yok" Description="Seçtiğiniz durumda kredi satın alması bulunmuyor." />
    }
    else if (_payments is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Zaman</TableHead>
                    <TableHead>Uzman</TableHead>
                    <TableHead>Paket</TableHead>
                    <TableHead Class="text-right">Kredi</TableHead>
                    <TableHead Class="text-right">Tutar</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var payment in _payments)
                {
                    <TableRow>
                        <TableCell Class="text-muted-foreground">
                            @payment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            <div class="muted font-mono">@payment.MerchantOid</div>
                        </TableCell>
                        <TableCell>
                            @payment.ExpertName
                            <div class="muted">@payment.ExpertEmail</div>
                        </TableCell>
                        <TableCell>@payment.PackageName</TableCell>
                        <TableCell Class="text-right">@payment.Credits</TableCell>
                        <TableCell Class="text-right">@FormatPrice(payment.AmountTry)</TableCell>
                        <TableCell><StatusChip Status="@payment.Status" /></TableCell>
                        <TableCell Class="cell-actions">
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => ToggleLedger(payment.Id)">
                                @(_openPaymentId == payment.Id ? "Kapat" : "Uzman Kredisi")
                            </Button>
                        </TableCell>
                    </TableRow>

                    @if (_openPaymentId == payment.Id)
                    {
                        <TableRow>
                            <TableCell Class="detail-cell" colspan="7">
                                <div class="detail-panel">
                                    <ExpertCreditPanel ExpertId="payment.ExpertId" />
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                }
            </TableBody>
        </Table>
        <Pager Meta="_meta" Disabled="_isLoading" OnPageChanged="GoToPageAsync" />
    }
</Card>

@code {
    private const int PerPage = 25;
    private static readonly System.Globalization.CultureInfo Turkish = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");

    private IReadOnlyList<AdminCreditPaymentListItemDto>? _payments;
    private AdminPageMetaDto? _meta;
    private int _page = 1;
    private string _status = string.Empty;
    private Guid? _openPaymentId;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task FilterAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _openPaymentId = null;
        try
        {
            var result = await AdminClient.ListCreditPaymentsAsync(
                new AdminCreditPaymentQueryDto(_status, _page, PerPage),
                CancellationToken.None);
            _payments = result.Value?.Data;
            _meta = result.Value?.Meta;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleLedger(Guid paymentId) => _openPaymentId = _openPaymentId == paymentId ? null : paymentId;

    private static string FormatPrice(decimal price) => $"{price.ToString("N2", Turkish)} ₺";
}
