@page "/settings"
@inject IAdminClientService AdminClient
@inject AdminSessionState Session
@inject NavigationManager Navigation

<PageTitle>Sistem Ayarları — PsikoAl Admin</PageTitle>

<PageHeader Title="Sistem Ayarları"
            Description="Bu değerler geriye dönük etkilemez — yalnızca bundan sonra oluşan kayıtlara uygulanır." />

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="table-card">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_settings is { Count: 0 })
    {
        <EmptyState Title="Ayar bulunamadı" Description="Sistem parametreleri henüz tanımlanmamış." />
    }
    else if (_settings is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Anahtar</TableHead>
                    <TableHead>Açıklama</TableHead>
                    <TableHead>Değer</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var setting in _settings)
                {
                    <TableRow>
                        <TableCell Class="font-medium">@setting.Key</TableCell>
                        <TableCell Class="text-muted-foreground">@setting.Description</TableCell>
                        <TableCell>
                            <Input Class="w-48"
                                   Value="@_editValues.GetValueOrDefault(setting.Key, setting.Value)"
                                   ValueChanged="value => _editValues[setting.Key] = value" />
                        </TableCell>
                        <TableCell Class="cell-actions">
                            <Button Size="ButtonSize.Sm" OnClick="() => SaveAsync(setting.Key)">Kaydet</Button>
                        </TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    }
</Card>

@code {
    private IReadOnlyList<SystemSettingDto>? _settings;
    private readonly Dictionary<string, string> _editValues = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _settings = await AdminClient.ListSystemSettingsAsync(CancellationToken.None);
            if (_settings is null)
            {
                _errorMessage = "Liste alınamadı. Admin yetkiniz olmayabilir.";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync(string key)
    {
        var value = _editValues.GetValueOrDefault(key);
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (await AdminClient.UpdateSystemSettingAsync(key, value, CancellationToken.None))
        {
            await LoadAsync();
        }
        else
        {
            _errorMessage = $"{key} güncellenemedi.";
        }
    }
}
