@page "/reviews"
@inject IAdminClientService AdminClient
@inject AdminSessionState Session
@inject NavigationManager Navigation

<PageTitle>Yorumlar — PsikoAl Admin</PageTitle>

<PageHeader Title="Yorum Moderasyonu"
            Description="Yalnızca onaylanan yorumlar uzmanın puanına ve yorum sayısına dahil edilir." />

<div class="toolbar">
    <Select Class="toolbar-select" @bind-Value="_status">
        <option value="pending">Onay Bekleyen</option>
        <option value="approved">Onaylı</option>
        <option value="rejected">Reddedilmiş</option>
        <option value="">Tümü</option>
    </Select>
    <Button Disabled="_isLoading" OnClick="LoadAsync">Filtrele</Button>
</div>

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="table-card">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_reviews is { Count: 0 })
    {
        <EmptyState Title="Yorum bulunamadı" Description="Seçtiğiniz durumda bekleyen bir yorum yok." />
    }
    else if (_reviews is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Uzman</TableHead>
                    <TableHead>Danışan</TableHead>
                    <TableHead>Puan</TableHead>
                    <TableHead>Yorum</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var review in _reviews)
                {
                    <TableRow>
                        <TableCell>@review.ExpertName</TableCell>
                        <TableCell Class="text-muted-foreground">@review.ClientName</TableCell>
                        <TableCell>@review.Rating / 5</TableCell>
                        <TableCell Class="max-w-sm">
                            @review.Comment
                            @if (review.Status == "rejected" && review.RejectionReason is not null)
                            {
                                <div class="muted">Red sebebi: @review.RejectionReason</div>
                            }
                        </TableCell>
                        <TableCell><StatusChip Status="@review.Status" /></TableCell>
                        <TableCell Class="cell-actions">
                            @if (review.Status == "pending")
                            {
                                <Button Size="ButtonSize.Sm" OnClick="() => ApproveAsync(review.Id)">Onayla</Button>
                                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                        OnClick="() => AskReject(review.Id)">
                                    Reddet
                                </Button>
                            }
                        </TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    }
</Card>

<ReasonDialog Open="_isRejectDialogOpen"
              OpenChanged="value => _isRejectDialogOpen = value"
              Title="Yorumu reddet"
              Description="Red sebebi danışana bildirim olarak iletilir."
              ReasonLabel="Red sebebi"
              Placeholder="Hakaret, kişisel veri, spam..."
              ConfirmLabel="Reddet"
              OnConfirm="RejectConfirmedAsync" />

@code {
    private IReadOnlyList<AdminReviewListItemDto>? _reviews;
    private string _status = "pending";
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _isRejectDialogOpen;
    private Guid? _pendingRejectReviewId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _reviews = await AdminClient.ListReviewsAsync(_status, CancellationToken.None);
            if (_reviews is null)
            {
                _errorMessage = "Liste alınamadı. Admin yetkiniz olmayabilir.";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApproveAsync(Guid reviewId)
    {
        if (await AdminClient.ApproveReviewAsync(reviewId, CancellationToken.None))
        {
            await LoadAsync();
        }
    }

    private void AskReject(Guid reviewId)
    {
        _pendingRejectReviewId = reviewId;
        _isRejectDialogOpen = true;
    }

    private async Task RejectConfirmedAsync(string reason)
    {
        if (_pendingRejectReviewId is not { } reviewId)
        {
            return;
        }

        _pendingRejectReviewId = null;

        if (await AdminClient.RejectReviewAsync(reviewId, reason, CancellationToken.None))
        {
            await LoadAsync();
        }
    }
}
