@page "/notifications"
@inject IAdminClientService AdminClient
@inject AdminSessionState Session
@inject NavigationManager Navigation

<PageTitle>Bildirimler — PsikoAl Admin</PageTitle>

<PageHeader Title="Bildirimler"
            Description="Şablon metinlerini düzenleyin veya bir segmente manuel duyuru gönderin." />

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

@if (_infoMessage is not null)
{
    <Alert Class="mb-4">
        <AlertDescription>@_infoMessage</AlertDescription>
    </Alert>
}

<Tabs DefaultValue="templates">
    <TabsList>
        <TabsTrigger Value="templates">Şablonlar</TabsTrigger>
        <TabsTrigger Value="send">Manuel Gönder</TabsTrigger>
    </TabsList>

    <TabsContent Value="templates">
        <Card Class="table-card">
            @if (_isLoading)
            {
                <LoadingSkeleton />
            }
            else if (_templates is { Count: 0 })
            {
                <EmptyState Title="Şablon bulunamadı" Description="Bildirim şablonları henüz tanımlanmamış." />
            }
            else if (_templates is not null)
            {
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead>Tip</TableHead>
                            <TableHead>Başlık</TableHead>
                            <TableHead>Kanallar</TableHead>
                            <TableHead>Durum</TableHead>
                            <TableHead Class="text-right">İşlem</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var template in _templates)
                        {
                            <TableRow>
                                <TableCell Class="text-muted-foreground font-mono text-xs">@template.Type</TableCell>
                                <TableCell>@template.Title</TableCell>
                                <TableCell Class="text-muted-foreground text-xs">@ChannelLabel(template)</TableCell>
                                <TableCell>
                                    <StatusChip Status="@(template.IsActive ? "active" : "frozen")"
                                                Label="@(template.IsActive ? "Aktif" : "Pasif")" />
                                </TableCell>
                                <TableCell Class="cell-actions">
                                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                            OnClick="() => ToggleEdit(template)">
                                        @(_editingType == template.Type ? "Kapat" : "Düzenle")
                                    </Button>
                                </TableCell>
                            </TableRow>

                            @if (_editingType == template.Type)
                            {
                                <TableRow>
                                    <TableCell Class="detail-cell" colspan="5">
                                        <div class="stack-3">
                                            <div class="field">
                                                <Label>Başlık</Label>
                                                <Input @bind-Value="_editTitle" />
                                            </div>
                                            <div class="field">
                                                <Label>Gövde — {değişken} yer tutucuları kullanılabilir</Label>
                                                <Textarea Rows="3" @bind-Value="_editBody" />
                                            </div>
                                            <div class="field">
                                                <Label>HTML gövde (e-posta) — boş bırakılırsa gövde otomatik sarmalanır</Label>
                                                <Textarea Rows="3" Value="@(_editHtmlBody ?? string.Empty)"
                                                          ValueChanged="value => _editHtmlBody = value" />
                                            </div>
                                            <div class="detail-actions">
                                                <div class="switch-field">
                                                    <Switch @bind-Checked="_editInApp" /><span>In-app</span>
                                                </div>
                                                <div class="switch-field">
                                                    <Switch @bind-Checked="_editPush" /><span>Push</span>
                                                </div>
                                                <div class="switch-field">
                                                    <Switch @bind-Checked="_editEmail" /><span>E-posta</span>
                                                </div>
                                                <div class="switch-field">
                                                    <Switch @bind-Checked="_editActive" /><span>Aktif</span>
                                                </div>
                                                <Button Size="ButtonSize.Sm" OnClick="() => SaveTemplateAsync(template.Type)">
                                                    Kaydet
                                                </Button>
                                            </div>
                                        </div>
                                    </TableCell>
                                </TableRow>
                            }
                        }
                    </TableBody>
                </Table>
            }
        </Card>
    </TabsContent>

    <TabsContent Value="send">
        <Card>
            <CardHeader>
                <CardTitle>Manuel Bildirim</CardTitle>
                <CardDescription>Tek bir kullanıcıya veya bir segmente SYSTEM tipinde duyuru gönderir.</CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="form-grid">
                    <div class="field">
                        <Label>Hedef</Label>
                        <Select @bind-Value="_targetType">
                            <option value="segment">Segment</option>
                            <option value="user">Tek Kullanıcı</option>
                        </Select>
                    </div>

                    @if (_targetType == TargetTypeSegment)
                    {
                        <div class="field">
                            <Label>Rol</Label>
                            <Select @bind-Value="_segmentRole">
                                <option value="client">Tüm Danışanlar</option>
                                <option value="expert">Tüm Uzmanlar</option>
                            </Select>
                        </div>
                        <div class="field">
                            <Label>Şehir (opsiyonel)</Label>
                            <Input Placeholder="İstanbul" @bind-Value="_segmentCity" />
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <Label>Kullanıcı ID</Label>
                            <Input Placeholder="uuid" @bind-Value="_targetUserId" />
                        </div>
                    }
                </div>

                <div class="field">
                    <Label>Başlık</Label>
                    <Input @bind-Value="_sendTitle" />
                </div>
                <div class="field">
                    <Label>Mesaj</Label>
                    <Textarea Rows="3" @bind-Value="_sendBody" />
                </div>
            </CardContent>
            <CardFooter>
                <Button Disabled="_isSending" IsLoading="_isSending" OnClick="SendAsync">Gönder</Button>
            </CardFooter>
        </Card>
    </TabsContent>
</Tabs>

@code {
    private const string TargetTypeSegment = "segment";
    private const string TargetTypeUser = "user";

    private IReadOnlyList<AdminNotificationTemplateDto>? _templates;
    private string? _editingType;
    private string _editTitle = string.Empty;
    private string _editBody = string.Empty;
    private string? _editHtmlBody;
    private bool _editInApp;
    private bool _editPush;
    private bool _editEmail;
    private bool _editActive;

    private string _targetType = TargetTypeSegment;
    private string _segmentRole = "client";
    private string _segmentCity = string.Empty;
    private string _targetUserId = string.Empty;
    private string _sendTitle = string.Empty;
    private string _sendBody = string.Empty;
    private bool _isSending;

    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _infoMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _templates = await AdminClient.ListNotificationTemplatesAsync(CancellationToken.None);
            if (_templates is null)
            {
                _errorMessage = "Liste alınamadı. Admin yetkiniz olmayabilir.";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string ChannelLabel(AdminNotificationTemplateDto template)
    {
        var channels = new List<string>();
        if (template.InAppEnabled)
        {
            channels.Add("in-app");
        }

        if (template.PushEnabled)
        {
            channels.Add("push");
        }

        if (template.EmailEnabled)
        {
            channels.Add("e-posta");
        }

        return channels.Count > 0 ? string.Join(", ", channels) : "—";
    }

    private void ToggleEdit(AdminNotificationTemplateDto template)
    {
        if (_editingType == template.Type)
        {
            _editingType = null;
            return;
        }

        _editingType = template.Type;
        _editTitle = template.Title;
        _editBody = template.Body;
        _editHtmlBody = template.HtmlBody;
        _editInApp = template.InAppEnabled;
        _editPush = template.PushEnabled;
        _editEmail = template.EmailEnabled;
        _editActive = template.IsActive;
    }

    private async Task SaveTemplateAsync(string type)
    {
        var updated = await AdminClient.UpdateNotificationTemplateAsync(
            type,
            new UpdateAdminNotificationTemplateDto(_editTitle, _editBody, _editHtmlBody, _editPush, _editEmail, _editInApp, _editActive),
            CancellationToken.None);

        if (updated is not null)
        {
            _editingType = null;
            await LoadAsync();
        }
        else
        {
            _errorMessage = "Şablon güncellenemedi.";
        }
    }

    private async Task SendAsync()
    {
        _errorMessage = null;
        _infoMessage = null;

        if (string.IsNullOrWhiteSpace(_sendTitle) || string.IsNullOrWhiteSpace(_sendBody))
        {
            _errorMessage = "Başlık ve mesaj zorunludur.";
            return;
        }

        Guid? userId = null;
        if (_targetType == TargetTypeUser)
        {
            if (!Guid.TryParse(_targetUserId, out var parsed))
            {
                _errorMessage = "Geçerli bir kullanıcı ID giriniz.";
                return;
            }

            userId = parsed;
        }

        _isSending = true;
        try
        {
            var request = new AdminSendNotificationDto(
                _targetType,
                userId,
                _targetType == TargetTypeSegment ? _segmentRole : null,
                _targetType == TargetTypeSegment && !string.IsNullOrWhiteSpace(_segmentCity) ? _segmentCity : null,
                null,
                _sendTitle,
                _sendBody);

            var recipientCount = await AdminClient.SendNotificationAsync(request, CancellationToken.None);
            if (recipientCount is null)
            {
                _errorMessage = "Bildirim gönderilemedi.";
                return;
            }

            _infoMessage = $"{recipientCount} kullanıcıya bildirim gönderildi.";
            _sendTitle = string.Empty;
            _sendBody = string.Empty;
        }
        finally
        {
            _isSending = false;
        }
    }
}
