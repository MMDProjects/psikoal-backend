@page "/credit-packages"
@inject IAdminClientService AdminClient

<PageTitle>Kredi Paketleri — PsikoAl Admin</PageTitle>

<PageHeader Title="Kredi Paketleri"
            Description="Uzmanların web sitesinden satın alabileceği kredi paketleri. Pasif paket web sitesinde listelenmez; satın alma geçmişi olan paket silinemez, pasife alınır. Teklif başına kredi maliyeti Ayarlar'daki OFFER_CREDIT_COST değeridir." />

@if (_errorMessage is not null)
{
    <Alert Variant="AlertVariant.Destructive" Class="mb-4">
        <AlertDescription>@_errorMessage</AlertDescription>
    </Alert>
}

<Card Class="mb-4">
    <CardHeader>
        <CardTitle>@(_editingId is null ? "Yeni Paket" : "Paketi Düzenle")</CardTitle>
        <CardDescription>Fiyat Türk lirası (KDV dahil), kredi sayısı tam sayıdır.</CardDescription>
    </CardHeader>
    <CardContent>
        <div class="form-grid">
            <div class="field">
                <Label>Paket adı</Label>
                <Input data-testid="credit-package-name" Placeholder="Başlangıç" @bind-Value="_name" />
            </div>
            <div class="field">
                <Label>Kredi</Label>
                <Input Type="number" data-testid="credit-package-credits" Placeholder="20" @bind-Value="_credits" />
            </div>
            <div class="field">
                <Label>Fiyat (₺)</Label>
                <Input data-testid="credit-package-price" Placeholder="500,00" @bind-Value="_price" />
            </div>
            <div class="field">
                <Label>Sıra</Label>
                <Input Type="number" data-testid="credit-package-sort" Placeholder="0" @bind-Value="_sortOrder" />
            </div>
        </div>
        <div class="switch-field mt-4">
            <Switch Checked="_isActive" CheckedChanged="value => _isActive = value" />
            <span>Web sitesinde satışta</span>
        </div>
    </CardContent>
    <CardFooter>
        <div class="detail-actions">
            <Button data-testid="credit-package-save" Disabled="_isSaving" IsLoading="_isSaving" OnClick="SaveAsync">
                @(_editingId is null ? "Ekle" : "Kaydet")
            </Button>
            @if (_editingId is not null)
            {
                <Button Variant="ButtonVariant.Outline" OnClick="ResetForm">Vazgeç</Button>
            }
        </div>
    </CardFooter>
</Card>

<Card Class="table-card" data-testid="credit-package-table">
    @if (_isLoading)
    {
        <LoadingSkeleton />
    }
    else if (_packages is { Count: 0 })
    {
        <EmptyState Title="Paket yok" Description="Yukarıdaki formdan ilk kredi paketini ekleyin." />
    }
    else if (_packages is not null)
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead>Sıra</TableHead>
                    <TableHead>Ad</TableHead>
                    <TableHead Class="text-right">Kredi</TableHead>
                    <TableHead Class="text-right">Fiyat</TableHead>
                    <TableHead Class="text-right">Satış</TableHead>
                    <TableHead>Durum</TableHead>
                    <TableHead Class="text-right">İşlem</TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var package in _packages)
                {
                    <TableRow>
                        <TableCell>@package.SortOrder</TableCell>
                        <TableCell>@package.Name</TableCell>
                        <TableCell Class="text-right">@package.Credits</TableCell>
                        <TableCell Class="text-right">@FormatPrice(package.PriceTry)</TableCell>
                        <TableCell Class="text-right">@package.PaidPurchaseCount</TableCell>
                        <TableCell>
                            <StatusChip Status="@(package.IsActive ? "active" : "frozen")"
                                        Label="@(package.IsActive ? "Satışta" : "Pasif")" />
                        </TableCell>
                        <TableCell Class="cell-actions">
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => Edit(package)">Düzenle</Button>
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" OnClick="() => AskDelete(package)">Sil</Button>
                        </TableCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    }
</Card>

<ConfirmDialog Open="_isDeleteDialogOpen"
               OpenChanged="value => _isDeleteDialogOpen = value"
               Title="Paketi sil"
               Description="@($"\"{_pendingDelete?.Name}\" paketi kalıcı olarak silinecek. Satın alma geçmişi olan paketler silinemez; onları pasife alın.")"
               ConfirmLabel="Sil"
               ConfirmVariant="ButtonVariant.Destructive"
               OnConfirm="DeleteConfirmedAsync" />

@code {
    private static readonly System.Globalization.CultureInfo Turkish = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");

    private IReadOnlyList<AdminCreditPackageDto>? _packages;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private bool _isDeleteDialogOpen;
    private AdminCreditPackageDto? _pendingDelete;

    private Guid? _editingId;
    private string _name = string.Empty;
    private string _credits = string.Empty;
    private string _price = string.Empty;
    private string _sortOrder = "0";
    private bool _isActive = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var result = await AdminClient.ListCreditPackagesAsync(CancellationToken.None);
            _packages = result.Value;
            _errorMessage = result.ErrorMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)
            || !int.TryParse(_credits, out var credits) || credits <= 0
            || !decimal.TryParse(_price, System.Globalization.NumberStyles.Number, Turkish, out var price) || price <= 0
            || !int.TryParse(_sortOrder, out var sortOrder) || sortOrder < 0)
        {
            _errorMessage = "Paket adı, pozitif kredi ve fiyat zorunludur; sıra 0 ya da büyük olmalıdır.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            var result = _editingId is { } id
                ? await AdminClient.UpdateCreditPackageAsync(
                    id, new UpdateAdminCreditPackageDto(_name.Trim(), credits, price, _isActive, sortOrder), CancellationToken.None)
                : await AdminClient.CreateCreditPackageAsync(
                    new CreateAdminCreditPackageDto(_name.Trim(), credits, price, _isActive, sortOrder), CancellationToken.None);

            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage;
                return;
            }

            ResetForm();
            await LoadAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Edit(AdminCreditPackageDto package)
    {
        _editingId = package.Id;
        _name = package.Name;
        _credits = package.Credits.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _price = package.PriceTry.ToString("0.00", Turkish);
        _sortOrder = package.SortOrder.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _isActive = package.IsActive;
    }

    private void ResetForm()
    {
        _editingId = null;
        _name = _credits = _price = string.Empty;
        _sortOrder = "0";
        _isActive = true;
    }

    private void AskDelete(AdminCreditPackageDto package)
    {
        _pendingDelete = package;
        _isDeleteDialogOpen = true;
    }

    private async Task DeleteConfirmedAsync()
    {
        _isDeleteDialogOpen = false;
        if (_pendingDelete is not { } package)
        {
            return;
        }

        _pendingDelete = null;
        var result = await AdminClient.DeleteCreditPackageAsync(package.Id, CancellationToken.None);
        _errorMessage = result.ErrorMessage;
        if (result.Succeeded)
        {
            if (_editingId == package.Id)
            {
                ResetForm();
            }

            await LoadAsync();
        }
    }

    private static string FormatPrice(decimal price) => $"{price.ToString("N2", Turkish)} ₺";
}
