@page "/login"
@layout PsikoAl.Client.Components.Layout.BareLayout
@inject IAdminClientService AdminClient
@inject NavigationManager Navigation

<PageTitle>Giriş — PsikoAl Admin</PageTitle>

<div class="auth-shell">
    <Card Class="auth-card">
        <CardHeader>
            <span class="auth-brand">PsikoAl Admin</span>
            <CardTitle>Yönetim Paneli</CardTitle>
            <CardDescription>Devam etmek için hesabınızla giriş yapın.</CardDescription>
        </CardHeader>
        <CardContent Class="space-y-4">
            <div class="field">
                <Label For="email">E-posta</Label>
                <Input id="email" Type="email" @bind-Value="_email" Placeholder="ornek@psikoal.com" />
            </div>

            <div class="field">
                <Label For="password">Şifre</Label>
                <Input id="password" Type="password" @bind-Value="_password" />
            </div>

            @if (_errorMessage is not null)
            {
                <Alert Variant="AlertVariant.Destructive">
                    <AlertDescription>@_errorMessage</AlertDescription>
                </Alert>
            }
        </CardContent>
        <CardFooter>
            <Button Class="w-full" Disabled="_isBusy" IsLoading="_isBusy" OnClick="SubmitAsync">
                @(_isBusy ? "Giriş yapılıyor..." : "Giriş Yap")
            </Button>
        </CardFooter>
    </Card>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _isBusy;

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var succeeded = await AdminClient.LoginAsync(_email, _password, CancellationToken.None);
            if (!succeeded)
            {
                _errorMessage = "Giriş başarısız. Bilgilerinizi kontrol edin.";
                return;
            }

            Navigation.NavigateTo("/");
        }
        finally
        {
            _isBusy = false;
        }
    }
}
